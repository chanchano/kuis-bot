# Token bot dari @BotFather di Telegram
BOT_TOKEN=isi_token_bot_kamu_disini

# Kosongkan ini untuk mode polling (development lokal).
# Isi dengan URL publik app kamu untuk mode webhook (production di Railway/Render).
# Contoh: https://kuis-bot-production.up.railway.app
WEBHOOK_URL=

# Port server (Railway/Render biasanya set otomatis via env PORT)
PORT=3000
